---
/**
 * A page of writing (the changelog, the privacy policy): its title and a
 * line under it, then the text, set for reading.
 */
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** The line under the title. */
  lede?: string;
  /** Shown as it is, without the entrance (the title rising, the text fading up). */
  still?: boolean;
}

const { title, description, lede, still = false } = Astro.props;
---

<Base title={`${title} · Alto`} description={description}>
  <main class="doc">
    <header>
      {still ? <h1>{title}</h1> : <h1><span class="enter-line"><span>{title}</span></span></h1>}
      {lede && (
        <p class="lede" data-enter-fade={still ? undefined : ''}>
          {lede}
        </p>
      )}
      <slot name="meta" />
    </header>
    <article class="prose" data-enter-fade={still ? undefined : ''} style="--i: 1">
      <slot />
    </article>
  </main>
</Base>

<style>
  .doc {
    max-width: 760px;
    margin: 56px auto 0;
  }
  h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
  }
  .lede {
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 18px 0 0;
  }
  .prose {
    margin-top: 48px;
    line-height: 1.7;
  }
  /* The text's defaults, in :where() so a page's own classes win over them. */
  :global(:where(.prose h2)) {
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 56px 0 14px;
  }
  :global(:where(.prose h3)) {
    font-size: 1.1rem;
    font-weight: 500;
    margin: 32px 0 8px;
  }
  :global(:where(.prose p, .prose li)) {
    color: color-mix(in srgb, var(--fg) 82%, var(--muted));
  }
  :global(:where(.prose ul)) {
    padding-left: 1.2em;
  }
  :global(:where(.prose li)) {
    margin: 6px 0;
  }
  :global(:where(.prose code)) {
    font-size: 0.9em;
    padding: 1px 5px;
    border-radius: 6px;
    background: var(--glass);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  :global(:where(.prose hr)) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 48px 0;
  }
</style>
