---
import '@fontsource-variable/geist';
import SiteFooter from '../components/SiteFooter';
import SiteHeader from '../components/SiteHeader';
import { appIconUrl } from '../lib/app-icon';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Keep the page hidden until the live Alto window on it (AltoDemo) is
   * drawn, so it shows all at once: not without the window, nor with what's
   * around it out of place.
   */
  waitForDemo?: boolean;
}

const {
  title = 'Alto',
  description = 'Alto keeps folders on your computer in two-way sync with Google Drive, Dropbox, OneDrive, Proton Drive, Nextcloud and more.',
  waitForDemo = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={appIconUrl} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      waitForDemo ? (
        <>
          <script is:inline>
            // Hidden until the demo is drawn (or after a few seconds, whatever happens).
            document.documentElement.dataset.waiting = '';
            const show = () => {
              delete document.documentElement.dataset.waiting;
              document.documentElement.dataset.entered = '';
            };
            if (window.altoDemoReady) show();
            window.addEventListener('alto-demo:ready', show, { once: true });
            setTimeout(show, 4000);
          </script>
          <noscript>
            <style>{'html[data-waiting] body { opacity: 1 !important; }'}</style>
          </noscript>
        </>
      ) : (
        <script is:inline>
          // The hero's entrance plays as the page shows (site.css).
          document.documentElement.dataset.entered = '';
        </script>
      )
    }
  </head>
  <body>
    <div class="page">
      <SiteHeader client:load />
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
    transition: opacity 250ms ease;
  }
  html[data-waiting] body {
    opacity: 0;
  }
  img,
  svg {
    max-width: 100%;
  }
</style>
