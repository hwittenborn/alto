---
/**
 * The live Alto window with the providers' avatars floating around it, and
 * its Start Demo button (Restart once it's going). Start Demo sends the
 * avatars into the window's sidebar one after another (src/lib/slide-in.ts);
 * Restart sends them home. One per page.
 *
 * The page places the stage; the stage keeps its avatars in its side gutters
 * (`--stage-gutter`), overlapping the window's edges, and in a row above the
 * window on phones.
 */
import AltoDemo from '../demo/AltoDemo';
import { AVATAR_SIZE, siteProviders } from '../lib/providers';
import ProviderLogo from './ProviderLogo.astro';

interface Props {
  /** The window's height, as CSS. */
  height: string;
}

/** Where each avatar floats, in the providers' order: around the window's sides. */
const SPOTS = [
  { left: '52px', top: '14%', size: 76 },
  { left: 'calc(100% - 44px)', top: '10%', size: 66 },
  { left: '30px', top: '56%', size: 62 },
  { left: 'calc(100% - 58px)', top: '52%', size: 80 },
  { left: '64px', top: '90%', size: 64 },
];

/** The avatars' size on phones, in a row above the window. */
const PHONE_SIZE = 48;

const { height } = Astro.props;
const providers = siteProviders();
---

<section
  class="stage"
  id="try"
  aria-label="Alto, live"
  style={`--phone-size:${PHONE_SIZE}px;--phone-scale:${PHONE_SIZE / AVATAR_SIZE}`}
>
  <div class="logos">
    {
      providers.map((p, i) => {
        const spot = SPOTS[i]!;
        return (
          <ProviderLogo
            provider={p}
            size={spot.size}
            float
            class="spot"
            style={`left:${spot.left};top:${spot.top};--float-delay:${-i * 1.3}s`}
          />
        );
      })
    }
  </div>
  <div class="window" data-enter-settle style={`height:${height}`}>
    <AltoDemo client:only="react" height="100%" />
  </div>
  <div class="controls">
    <button type="button" class="button primary" data-start-demo>Start Demo</button>
  </div>
</section>

<script>
  import { setupSlideIn } from '../lib/slide-in';
  setupSlideIn();
  const button = document.querySelector<HTMLElement>('.stage [data-start-demo]');
  /** Whether the demo has been started (and not restarted since). */
  let started = false;
  // Start Demo, then Restart, which sends the avatars home (Start Demo then goes again).
  button?.addEventListener('click', () => {
    started = !started;
    button.textContent = started ? 'Restart' : 'Start Demo';
    window.dispatchEvent(new Event(started ? 'alto-demo:start' : 'alto-demo:restart'));
  });
</script>

<style>
  .stage {
    position: relative;
    padding: 0 var(--stage-gutter, 44px);
  }
  .window {
    position: relative;
    z-index: 1;
    transform-origin: 50% 40%;
  }
  .logos :global(.spot) {
    position: absolute;
    z-index: 5;
    /* Centered on its spot by margin: its bob animates `translate`. */
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
  }
  .controls {
    display: flex;
    justify-content: center;
    margin-top: 18px;
  }

  /* Phones: the avatars float in a row above the window instead of around it. */
  @media (max-width: 720px) {
    .stage {
      padding: 0;
    }
    .logos {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 22px;
    }
    .logos :global(.spot) {
      position: static;
      margin: 0;
      --size: var(--phone-size);
      --scale: var(--phone-scale);
    }
  }
</style>
