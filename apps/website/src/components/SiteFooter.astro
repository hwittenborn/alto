---
import { LINKS } from '../lib/providers';

/** This year, as of the build. */
const year = new Date().getFullYear();
---

<footer class="wrap">
  <span>© {year} Hunter Wittenborn</span>
  <nav>
    <a class="quiet-link" href={LINKS.privacy}>Privacy</a>
    <a class="quiet-link" href={LINKS.changelog}>Changelog</a>
    <a class="quiet-link" href={LINKS.github}>Source</a>
    <a class="quiet-link" href={LINKS.issues}>Report an issue</a>
  </nav>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 28px 0 90px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
  nav {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
</style>
