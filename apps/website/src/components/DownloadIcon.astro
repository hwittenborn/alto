---
/**
 * A download mark (an arrow into a tray) for buttons that get Alto, in the
 * button's text color and sized to its text.
 */
---

<svg class="download-icon" viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true">
  <path
    d="M8 1.75v7.5m0 0L5 6.25m3 3 3-3M2.75 10.5v1.75c0 .83.67 1.5 1.5 1.5h7.5c.83 0 1.5-.67 1.5-1.5V10.5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>

<style>
  .download-icon {
    display: block;
    flex: none;
  }
</style>
