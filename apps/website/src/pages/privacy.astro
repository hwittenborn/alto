---
/**
 * The privacy policy (src/views/PrivacyPage.tsx). "Last updated" is the date
 * of the last commit that changed its text, read from git when the site is
 * built (the build date before its first commit).
 */
import { execFileSync } from 'node:child_process';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import PrivacyPage from '../views/PrivacyPage';

function lastUpdated(): Date {
  try {
    const file = path.resolve('src/views/PrivacyPage.tsx');
    const date = execFileSync('git', ['log', '-1', '--format=%cI', '--', file], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
    if (date) return new Date(date);
  } catch {
    // Not in a git checkout: the build date, then.
  }
  return new Date();
}
---

<Base
  title="Privacy policy · Alto"
  description="What Alto, the cloud sync app, and its website do with your data: it stays between your computer and your cloud provider."
>
  <PrivacyPage updated={lastUpdated().toISOString()} host={Astro.site?.host ?? ''} />
</Base>
