---
/**
 * The changelog: CHANGELOG.md from the repository (release-please writes it),
 * so the page is current with every release. Each release: its version, the
 * date under it (and a link to its release on GitHub), then its changes.
 */
import linkIcon from '~icons/ph/arrow-square-out?raw';
import changelog from '../../../../CHANGELOG.md?raw';
import Doc from '../layouts/Doc.astro';
import { formatDate, parseChangelog } from '../lib/changelog';
import { LINKS } from '../lib/providers';

const releases = parseChangelog(changelog);
---

<Doc title="Changelog" description="What changed in each release of Alto." lede="Here's what changed in each release of Alto.">
  {
    releases.map((r) => (
      <section class="release" id={`v${r.version}`}>
        <header>
          <h2>
            {r.version}
            <a
              class="version-link"
              href={`${LINKS.github}/releases/tag/v${r.version}`}
              aria-label={`Alto ${r.version} on GitHub`}
              set:html={linkIcon}
            />
          </h2>
          {r.date && (
            <p class="date">
              <time datetime={r.date}>{formatDate(r.date)}</time>
            </p>
          )}
        </header>
        {r.intro.map((p) => (
          <p set:html={p} />
        ))}
        {r.groups.map((g) => (
          <>
            <h3>{g.title}</h3>
            <ul>
              {g.changes.map((c) => (
                <li>
                  <span set:html={c.html} />
                  {c.refs.length > 0 && <span class="refs" set:html={c.refs.join(' ')} />}
                </li>
              ))}
            </ul>
          </>
        ))}
      </section>
    ))
  }
</Doc>

<style>
  .release + .release {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .release header {
    margin-bottom: 18px;
  }
  /* The version, then its date under it. */
  .release h2 {
    font-size: 1.8rem;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.35em;
  }
  /* A link to the release's changes on GitHub, beside its version. */
  .version-link {
    display: flex;
    font-size: 0.6em;
    color: var(--muted);
    opacity: 0.7;
    transition: opacity 150ms ease-out;
  }
  .version-link:hover,
  .version-link:focus-visible {
    opacity: 1;
  }
  .version-link :global(svg) {
    display: block;
  }
  .date {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 4px 0 0;
  }
  .release h3 {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 22px 0 6px;
  }
  /* A change's issue and commit, small after it. */
  .refs {
    margin-left: 8px;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .refs :global(a) {
    color: var(--muted);
  }
  .refs :global(a + a) {
    margin-left: 6px;
  }
</style>
